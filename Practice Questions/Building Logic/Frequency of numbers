#include<iostream>
#include<vector>
#include<map>
using namespace std;
int main(){
    vector<int> arr;
    cout<<"Enter the amount of numbers:\n";
    int n;
    cin>>n;
    cout<<"Enter the numbers:\n";
    for(int i=0;i<n;i++){
        int x;
        cin>>x;
        arr.push_back(x);//input each element into the array.
    }
    map<int,int> freq;//map to map the frequency of each number. 
    for(int i:arr){
        freq[i]++;//to increase the frequency of all numbers. 
    }
    for(auto i:freq){
        cout<<"Frequency of "<<i.first<<" is: "<<i.second<<"\n";
    }
}